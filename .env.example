# ============================================================================
# Je Suis Radieuse - Environment Configuration Template
# ============================================================================
# Copy this file to .env and fill in your actual values before deployment
# ============================================================================

# ====================
# JWT Administration
# ====================
# Secret key for signing JWT admin tokens (use a strong random string)
# Generate with: openssl rand -base64 32
ADMIN_JWT_SECRET=your_jwt_secret_here_min_32_chars

# Hardcoded admin credentials (use strong passwords; migrate to secure vault in production)
ADMIN_EMAIL=admin@jesuisradieuse.fr
ADMIN_PASSWORD=your_secure_password_here

# ====================
# Database (Optional)
# ====================
# PostgreSQL connection string. If omitted, system runs in in-memory mode (no persistence)
# Format: postgresql://username:password@host:port/database
# Example: postgresql://postgres:pass123@localhost:5432/jesuisradieuse_db
DATABASE_URL=postgresql://username:password@localhost:5432/jesuisradieuse_db

# ====================
# Stripe Payment Processing
# ====================
# Stripe API Secret Key (not publishable key)
# Get from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key_here

# Stripe Webhook Signing Secret
# Get from: https://dashboard.stripe.com/webhooks (endpoint settings)
# Used to verify that webhook events actually come from Stripe
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

# ====================
# PayPal Payment Processing
# ====================
# PayPal Client ID
# Get from: https://developer.paypal.com/dashboard
PAYPAL_CLIENT_ID=your_paypal_client_id_here

# PayPal Client Secret
# Get from: https://developer.paypal.com/dashboard
PAYPAL_CLIENT_SECRET=your_paypal_client_secret_here

# PayPal mode: 'sandbox' for testing or 'live' for production
PAYPAL_MODE=sandbox

# ====================
# Website & Webhooks
# ====================
# Public URL of the website (used for payment redirects and webhook callbacks)
# Development: http://localhost:5173
# Production: https://www.jesuisradieuse.fr
PUBLIC_SITE_URL=http://localhost:5173

# Netlify Functions base URL (usually /.netlify/functions for Netlify hosting)
# Used by frontend to call backend APIs
VITE_FUNCTIONS_BASE_URL=/.netlify/functions

# Mondial Relay Widget Brand code (enseigne), required for official Point Relais widget
# Example format: CC20GQ7Y
VITE_MONDIAL_RELAY_BRAND=CC20GQ7Y

# ====================
# Email Configuration (Optional)
# ====================
# SMTP server for sending transactional emails (order confirmation, status updates, etc.)
# Example providers: Gmail, SendGrid, AWS SES, Mailgun

# SMTP host (e.g., smtp.gmail.com)
SMTP_HOST=smtp.gmail.com

# SMTP port (usually 587 for TLS or 465 for SSL)
SMTP_PORT=587

# SMTP authentication username
SMTP_USER=your_email@gmail.com

# SMTP authentication password (or app-specific password)
SMTP_PASSWORD=your_app_password_here

# Email address from which transactional emails are sent
SMTP_FROM_EMAIL=noreply@jesuisradieuse.fr

# ====================
# Sendcloud Shipping Integration (Optional)
# ====================
# Sendcloud API credentials for real shipping label generation
# Get from: https://panel.sendcloud.sc/settings/api/

# Sendcloud API Public Key
SENDCLOUD_API_KEY=your_sendcloud_api_key_here

# Sendcloud API Secret Key
SENDCLOUD_API_SECRET=your_sendcloud_secret_here

# ====================
# Logging & Monitoring (Optional)
# ====================
# Log level: 'debug', 'info', 'warn', 'error'
LOG_LEVEL=info

# ====================
# Deployment Notes
# ====================
# Netlify Environment Setup:
# 1. In Netlify dashboard: Site Settings → Build & Deploy → Environment
# 2. Add each variable pair (key=value)
# 3. Re-deploy to apply changes
#
# Security Best Practices:
# - NEVER commit .env file to Git (add to .gitignore)
# - Always use strong, unique secrets for each environment
# - Rotate secrets regularly
# - Use Netlify environment variables UI (not .env files) in production
# - Consider using Netlify Forms Encryption for sensitive data
# - Implement rate limiting on sensitive endpoints (auth, webhooks)
#
# Webhook Configuration:
# 1. Stripe: Add webhook to https://<YOUR_DOMAIN>/.netlify/functions/stripe-webhook
#    - Subscribe to: checkout.session.completed
# 2. PayPal: Add IPN listener to https://<YOUR_DOMAIN>/.netlify/functions/paypal-webhook
# 3. Shipping: Add webhook to https://<YOUR_DOMAIN>/.netlify/functions/shipping-webhook
#    - For Sendcloud label updates
